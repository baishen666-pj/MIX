FROM node:24-slim AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/ shared/
COPY gateway/ gateway/

RUN npm ci
RUN npm run build -w mix-gateway

FROM node:24-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY gateway/package.json gateway/package.json
COPY --from=builder /app/gateway/dist/ gateway/dist/
COPY shared/ shared/

RUN npm ci --omit=dev \
    && useradd --create-home mixuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:18789/api/health').then(r=>{process.exit(r.ok?0:1)}).catch(()=>process.exit(1))" || exit 1

USER mixuser

EXPOSE 18789

CMD ["node", "gateway/dist/gateway/src/index.js"]
