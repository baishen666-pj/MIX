# MIX Configuration
# Copy to .env and fill in your values

# Engine
MIX_ENGINE_HOST=127.0.0.1
MIX_ENGINE_PORT=18700

# Gateway
MIX_GATEWAY_HOST=127.0.0.1
MIX_GATEWAY_PORT=18789

# LLM Provider (openrouter | openai | anthropic | nvidia | local)
MIX_LLM_PROVIDER=openrouter
MIX_LLM_MODEL=openai/gpt-4o
MIX_LLM_API_KEY=your-api-key-here
# MIX_LLM_BASE_URL=

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=

# Discord (optional)
# DISCORD_BOT_TOKEN=

# Security
DM_POLICY=pairing
# ALLOWED_USERS=telegram:12345,discord:67890

# Memory
# MIX_DB=~/.mix/data/mix.db
