# MIX Configuration
# Copy to .env and fill in your values

# Engine
MIX_ENGINE_HOST=127.0.0.1
MIX_ENGINE_PORT=18700

# Gateway
MIX_GATEWAY_HOST=127.0.0.1
MIX_GATEWAY_PORT=18789

# LLM Provider (openrouter | openai | anthropic | nvidia | local)
MIX_LLM_PROVIDER=openrouter
MIX_LLM_MODEL=openai/gpt-4o
MIX_LLM_API_KEY=your-api-key-here
# MIX_LLM_BASE_URL=

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=

# Discord (optional)
# DISCORD_BOT_TOKEN=

# Slack (optional)
# SLACK_BOT_TOKEN=

# IRC (optional)
# IRC_SERVER=irc.libera.chat
# IRC_PORT=6667
# IRC_NICK=mix-bot
# IRC_CHANNELS=#mix-dev
# IRC_PASSWORD=
# IRC_TLS=false

# WhatsApp (optional — scan QR code on first start)
# WHATSAPP_ENABLED=true

# Matrix (optional)
# MATRIX_HOMESERVER=https://matrix.org
# MATRIX_ACCESS_TOKEN=
# MATRIX_USER_ID=@mix-bot:matrix.org
# MATRIX_ROOMS=!roomid:matrix.org

# LINE (optional)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=

# Google Chat (optional)
# GOOGLE_CHAT_WEBHOOK_URL=

# Signal (optional — requires signal-cli-rest)
# SIGNAL_SERVER_URL=http://localhost:8080
# SIGNAL_PHONE_NUMBER=

# Teams (optional)
# TEAMS_BOT_ID=
# TEAMS_BOT_PASSWORD=

# iMessage (optional — requires Apple Business Chat)
# IMESSAGE_BUSINESS_ID=
# IMESSAGE_API_ENDPOINT=

# Feishu (optional)
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# Security
DM_POLICY=pairing
# ALLOWED_USERS=telegram:12345,discord:67890
# ENGINE_API_KEY=your-engine-api-key
# CORS_ORIGINS=http://localhost:8080,http://localhost:18789

# Memory
# MIX_DB=~/.mix/data/mix.db
